SERVER=127.0.0.1
PORTA=3306
USER=root
PASS=
BANCO=futebol

# URL pública do sistema (usada nos links de confirmação enviados no WhatsApp).
# Vazio = detecta pelo endereço da requisição.
APP_URL=

# Permite criar contas de administrador pela tela de login (true/false)
CADASTRO_ABERTO=true

# Token para rodar as migrations pelo navegador: /cron/migrate.php?token=...
# Vazio = migrations só pela linha de comando (php cron/migrate.php)
MIGRATE_TOKEN=
